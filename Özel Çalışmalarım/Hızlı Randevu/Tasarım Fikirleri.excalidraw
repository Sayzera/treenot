      "lineHeight": 1.25
    },
    {
      "id": "l_Ztf3v5QP1du2asH7wSC",
      "type": "text",
      "x": 1265.6302795410156,
      "y": 958,
      "width": 688.8794555664062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 496646361,
      "version": 279,
      "versionNonce": 1383686329,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786085963352,
      "link": null,
      "locked": false,
      "text": "Ka\u00E7 randevu al\u0131nd\u0131, doluluk oran\u0131, en yo\u011Fun saatler, gelir raporu (az \u00F6nce\nkonu\u015Ftu\u011Fumuz gelir/gider kategorileri tam burada devreye giriyor)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ka\u00E7 randevu al\u0131nd\u0131, doluluk oran\u0131, en yo\u011Fun saatler, gelir raporu (az \u00F6nce konu\u015Ftu\u011Fumuz gelir/gider kategorileri tam burada devreye giriyor)",
      "autoResize": false,
      "lineHeight": 1.25
    }
