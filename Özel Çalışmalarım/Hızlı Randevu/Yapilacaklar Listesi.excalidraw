      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yapay zeka k\u0131sm\u0131n\u0131n sistem taraf\u0131ndan \u00F6nce kapat\u0131lmas\u0131 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Cr9Q3217R3nGI61LTplZN",
      "type": "text",
