      "isDeleted": false,
      "boundElements": null,
      "updated": 1786351159341,
      "link": null,
      "locked": false,
      "text": "\u015Euan ki hesaplar\u0131n deneme hesab\u0131 oldu\u011Funu ay\u0131rt etme ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u015Euan ki hesaplar\u0131n deneme hesab\u0131 oldu\u011Funu ay\u0131rt etme ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
