      "isDeleted": false,
      "boundElements": null,
      "updated": 1786351159341,
      "link": null,
      "locked": false,
      "text": "Her kullan\u0131c\u0131 kendi renk paletini se\u00E7ebilmeli \u00F6zelle\u015Ftirebilmeli",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
