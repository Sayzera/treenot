      "link": null,
      "locked": false,
      "text": "\u0130hale Onay Bekleyen Listesinde Zeyilname Onay \u0130\u015Flemleri ile a\u00E7\u0131lan sayfada;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u0130hale Onay Bekleyen Listesinde Zeyilname Onay \u0130\u015Flemleri ile a\u00E7\u0131lan sayfada;",
