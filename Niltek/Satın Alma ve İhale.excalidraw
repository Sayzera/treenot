      "isDeleted": false,
      "boundElements": [],
      "updated": 1786515825592,
      "link": null,
      "locked": false,
      "text": "Kaydet \u0130lerle butonuna t\u0131kland\u0131\u011F\u0131nda Zeyilname De\u011Fi\u015Fiklikleri sekmesine gitmesi\ngerekirken, Dosyalar sekmesine gitmektedir.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kaydet \u0130lerle butonuna t\u0131kland\u0131\u011F\u0131nda Zeyilname De\u011Fi\u015Fiklikleri sekmesine gitmesi gerekirken, Dosyalar sekmesine gitmektedir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
