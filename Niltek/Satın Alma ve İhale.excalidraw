    {
      "id": "nWElBlTH8p2uq4Dt6Ch8V",
      "type": "text",
      "x": 4645.470777239119,
      "y": 1260.4880952380952,
      "width": 766.4155883789062,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
