      "isDeleted": false,
      "boundElements": null,
      "updated": 1786351159341,
      "link": null,
      "locked": false,
      "text": "Gerekli testleri yap\u0131ld\u0131ktan sonra \u00FCcretli kullanc\u0131lara a\u00E7\u0131lmas\u0131",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gerekli testleri yap\u0131ld\u0131ktan sonra \u00FCcretli kullanc\u0131lara a\u00E7\u0131lmas\u0131",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cFrWH3hBqTfJY2qeLFRad",
      "type": "text",
      "x": 253.86583049743706,
      "y": 35.05811527878262,
      "width": 524.1796264648438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
