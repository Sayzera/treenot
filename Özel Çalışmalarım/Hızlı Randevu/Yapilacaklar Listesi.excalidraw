      "isDeleted": false,
      "boundElements": [],
      "updated": 1786544191878,
      "link": null,
      "locked": false,
      "text": "\u015Euan ki hesaplar\u0131n deneme hesab\u0131 oldu\u011Funu ay\u0131rt etme ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u015Euan ki hesaplar\u0131n deneme hesab\u0131 oldu\u011Funu ay\u0131rt etme ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Qmw7rD5S4LKtWvkJQY8zM",
      "type": "text",
      "x": 236.4212823548454,
      "y": 697.8024508886297,
      "width": 1348.4190673828125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
