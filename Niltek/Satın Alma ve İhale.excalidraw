      "isDeleted": false,
      "boundElements": [],
      "updated": 1785397667269,
      "link": null,
      "locked": false,
      "text": "\u0130lgili Firmalar sekmesinde Payla\u015F butonu ile mail\ntetiklemesinin yap\u0131lmas\u0131 istenmektedir.",
