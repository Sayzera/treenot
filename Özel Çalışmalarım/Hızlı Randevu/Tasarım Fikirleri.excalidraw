      "isDeleted": false,
      "boundElements": null,
      "updated": 1786085963352,
      "link": null,
      "locked": false,
      "text": "12. Raporlama/Analitik (\u0130\u015Fletme Sahibi \u0130\u00E7in)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "12. Raporlama/Analitik (\u0130\u015Fletme Sahibi \u0130\u00E7in)",
