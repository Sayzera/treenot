    {
      "id": "nHMfVlznpEH92fhBsK6U-",
      "type": "text",
      "x": 1519.0883885943704,
      "y": 366.88888888888886,
      "width": 340.55975341796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
