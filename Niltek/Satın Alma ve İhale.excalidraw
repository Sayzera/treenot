    {
      "id": "r0JkJ14WpwwABKjFA_N62",
      "type": "text",
      "x": 7149.4928690592515,
      "y": 68.58630952380918,
      "width": 758.6876220703125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b37",
      "roundness": null,
      "seed": 1579536817,
      "version": 47,
      "versionNonce": 446509663,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785401248822,
      "link": null,
      "locked": false,
      "text": "Zeyilname olu\u015Fturuldu, sat\u0131nalma talepte onayland\u0131, ihale\nbekleyen listesinde zeyilname d\u00FCzenle butonuna t\u0131kland\u0131.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zeyilname olu\u015Fturuldu, sat\u0131nalma talepte onayland\u0131, ihale bekleyen listesinde zeyilname d\u00FCzenle butonuna t\u0131kland\u0131.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "6qcFsy0DxnPFGS2BLL8BU",
      "type": "text",
      "x": 7149.4928690592515,
      "y": 177.39880952380918,
      "width": 767.6197509765625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b38",
      "roundness": null,
      "seed": 1562254815,
      "version": 45,
      "versionNonce": 2116390527,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785401248822,
      "link": null,
      "locked": false,
      "text": "Zeyilname Listesine kay\u0131t d\u00FC\u015Ft\u00FC\u011F\u00FCnde detayda sat\u0131nalma\ntalepten gelmesi gereken mevcut ve d\u00FCzeltme alanlar\u0131 bo\u015F\ngeldi. (Frontend)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zeyilname Listesine kay\u0131t d\u00FC\u015Ft\u00FC\u011F\u00FCnde detayda sat\u0131nalma talepten gelmesi gereken mevcut ve d\u00FCzeltme alanlar\u0131 bo\u015F geldi. (Frontend)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Bx8QDLkM5fC3LbaxI_7k-",
      "type": "text",
      "x": 7149.4928690592515,
      "y": 321.2113095238092,
      "width": 768.6277465820312,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b39",
      "roundness": null,
      "seed": 566391697,
      "version": 46,
      "versionNonce": 1686988447,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785401248822,
      "link": null,
      "locked": false,
      "text": "\u0130hale Onay Bekleyen Listesinde Onay pop-up\u0027\u0131nda Mevcut\nve D\u00FCzeltme alanlar\u0131 gelmiyor.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u0130hale Onay Bekleyen Listesinde Onay pop-up\u0027\u0131nda Mevcut ve D\u00FCzeltme alanlar\u0131 gelmiyor.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kW3E8W-A1HT6qf5XKIc9Q",
      "type": "text",
      "x": 7149.4928690592515,
      "y": 430.0238095238092,
      "width": 793.771728515625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3A",
      "roundness": null,
      "seed": 679283199,
      "version": 66,
      "versionNonce": 1015364287,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785401248822,
      "link": null,
      "locked": false,
      "text": "Zeyilname Listesi detay\u0131nda Zeyilname dok\u00FCman\u0131 eklemeden\nonaya g\u00F6nderim olmayacakt\u0131r. (Zeyilname sekmesindeki\nyay\u0131nlanma durumuna g\u00F6re pdf eklenen dok\u00FCman)(Backend \u002B\nFrontend)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zeyilname Listesi detay\u0131nda Zeyilname dok\u00FCman\u0131 eklemeden onaya g\u00F6nderim olmayacakt\u0131r. (Zeyilname sekmesindeki yay\u0131nlanma durumuna g\u00F6re pdf eklenen dok\u00FCman)(Backend \u002B Frontend)",
      "autoResize": false,
      "lineHeight": 1.25
    },
