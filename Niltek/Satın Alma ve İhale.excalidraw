      "isDeleted": false,
      "boundElements": [],
      "updated": 1786109813977,
      "link": null,
      "locked": false,
      "text": "Merve Y\u0131ld\u0131r\u0131m taraf\u0131ndan yakla\u015F\u0131k 2 ay \u00F6nce g\u00FCncellendi",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Merve Y\u0131ld\u0131r\u0131m taraf\u0131ndan yakla\u015F\u0131k 2 ay \u00F6nce g\u00FCncellendi",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dYE3d30kUJzgIdUyjTNTm",
      "type": "text",
      "x": 8765.556094820515,
      "y": 918.4619966716655,
      "width": 202.59983825683594,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
