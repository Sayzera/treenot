      "isDeleted": false,
      "boundElements": [],
      "updated": 1786516161839,
      "link": null,
      "locked": false,
      "text": "Zeyilname Dok\u00FCmanlar\u0131 b\u00F6l\u00FCm\u00FCnde yaln\u0131zca ilgili zeyilnamedeki ilan veya zeyilname\ndok\u00FCman\u0131n\u0131n gelmesi gerekmektedir.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zeyilname Dok\u00FCmanlar\u0131 b\u00F6l\u00FCm\u00FCnde yaln\u0131zca ilgili zeyilnamedeki ilan veya zeyilname dok\u00FCman\u0131n\u0131n gelmesi gerekmektedir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
