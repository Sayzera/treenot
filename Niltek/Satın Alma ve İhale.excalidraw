      "isDeleted": false,
      "boundElements": [],
      "updated": 1785411634657,
      "link": null,
      "locked": false,
      "text": "Sat\u0131nalma talepten gelmesi gereken dok\u00FCmanlar, Dosyalar\nsekmesine gelmedi. (Frontend)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sat\u0131nalma talepten gelmesi gereken dok\u00FCmanlar, Dosyalar sekmesine gelmedi. (Frontend)",
      "autoResize": false,
      "lineHeight": 1.25
    },
