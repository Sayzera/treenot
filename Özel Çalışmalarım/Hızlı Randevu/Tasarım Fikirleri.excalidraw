      "versionNonce": 2017670681,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786085963352,
      "link": null,
      "locked": false,
      "text": "Binlerce i\u015Fletme oldu\u011Funda takvim sorgular\u0131n\u0131n h\u0131zl\u0131 \u00E7al\u0131\u015Fmas\u0131 (do\u011Fru indexleme \u2014\nbusiness_id, date \u00FCzerinde composite index \u015Fart)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Binlerce i\u015Fletme oldu\u011Funda takvim sorgular\u0131n\u0131n h\u0131zl\u0131 \u00E7al\u0131\u015Fmas\u0131 (do\u011Fru indexleme \u2014 business_id, date \u00FCzerinde composite index \u015Fart)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "zFk1YBKKPeJaYBIGXZ1Ot",
      "type": "text",
      "x": 1265.6302795410156,
      "y": 820.5,
      "width": 731.2994384765625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
