      "isDeleted": false,
      "boundElements": [],
      "updated": 1786109813977,
      "link": null,
      "locked": false,
      "text": "Merhaba Furkan Bey,",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Merhaba Furkan Bey,",
      "autoResize": true,
