    },
    {
      "id": "rHhIuaU49yjKYVqVciBEH",
      "type": "text",
      "x": 253.74029541015625,
      "y": 646.75,
      "width": 934.5194091796874,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 76063648,
      "version": 61,
      "versionNonce": 1901118048,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784901747399,
      "link": null,
      "locked": false,
      "text": "Dok\u00FCman Payla\u015F\u0131m\u0131 sekmesi alt\u0131ndaki Dok\u00FCmanlar sekmesinde yap\u0131lan dosya ekleme i\u015Flevi;\nZeyilname Listesi detay\u0131na da eklenecek, Zeyil Zip Dosyas\u0131 tipinde dok\u00FCman eklemesi\nyap\u0131lacakt\u0131r. Sekme i\u00E7erisinde \u0022Kaydet\u0022 butonu bulunmakta, ek olarak \u0022Payla\u015F\u0022 butonu\neklenecektir. Bu yeni eklenen b\u00F6l\u00FCm \u0130lgili Zeyilnamenin durumu onayland\u0131 ise g\u00F6sterilecektir.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dok\u00FCman Payla\u015F\u0131m\u0131 sekmesi alt\u0131ndaki Dok\u00FCmanlar sekmesinde yap\u0131lan dosya ekleme i\u015Flevi; Zeyilname Listesi detay\u0131na da eklenecek, Zeyil Zip Dosyas\u0131 tipinde dok\u00FCman eklemesi yap\u0131lacakt\u0131r. Sekme i\u00E7erisinde \u0022Kaydet\u0022 butonu bulunmakta, ek olarak \u0022Payla\u015F\u0022 butonu eklenecektir. Bu yeni eklenen b\u00F6l\u00FCm \u0130lgili Zeyilnamenin durumu onayland\u0131 ise g\u00F6sterilecektir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
