    {
      "id": "dKqBxvY652tWBGbTGZFJ6",
      "type": "text",
      "x": 2641.7058192661825,
      "y": 1122.8690476190477,
      "width": 1556.3264567057283,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 122590323,
      "version": 81,
      "versionNonce": 587331165,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787212349727,
      "link": null,
      "locked": false,
      "text": "Sistem i\u00E7erisinde genel anlamda yetkilendirme \u00E7al\u0131\u015Fmas\u0131 yap\u0131lmal\u0131d\u0131r. Ki\u015Filer sadece sorumlu olduklar\u0131 hesap kalemi\nbaz\u0131nda b\u00FCt\u00E7e \u00E7al\u0131\u015Fmas\u0131 yapmal\u0131d\u0131r. Yetkisi olmayan di\u011Fer hesap kalemleri ile ilgili verileri g\u00F6rmemeli ve i\u015Flem\nyapmamal\u0131d\u0131r. Mahremiyet korunmal\u0131d\u0131r.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistem i\u00E7erisinde genel anlamda yetkilendirme \u00E7al\u0131\u015Fmas\u0131 yap\u0131lmal\u0131d\u0131r. Ki\u015Filer sadece sorumlu olduklar\u0131 hesap kalemi baz\u0131nda b\u00FCt\u00E7e \u00E7al\u0131\u015Fmas\u0131 yapmal\u0131d\u0131r. Yetkisi olmayan di\u011Fer hesap kalemleri ile ilgili verileri g\u00F6rmemeli ve i\u015Flem yapmamal\u0131d\u0131r. Mahremiyet korunmal\u0131d\u0131r.",
      "autoResize": false,
      "lineHeight": 1.25
    },
