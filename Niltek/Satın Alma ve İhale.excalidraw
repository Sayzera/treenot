      "seed": 282500817,
      "version": 37,
      "versionNonce": 643931967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785397631812,
      "link": null,
      "locked": false,
      "text": "Dok\u00FCmanlar sekmesinde eklenmi\u015F olan Kaydet ve Payla\u015F\nbutonunun kald\u0131r\u0131lmas\u0131, yaln\u0131zca sat\u0131r bazl\u0131 kaydet olmas\u0131,",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dok\u00FCmanlar sekmesinde eklenmi\u015F olan Kaydet ve Payla\u015F butonunun kald\u0131r\u0131lmas\u0131, yaln\u0131zca sat\u0131r bazl\u0131 kaydet olmas\u0131,",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "arjfVaTmVGDROhszhbT_1",
      "type": "text",
      "x": 4639.698743547713,
      "y": 1388.4880952380952,
      "width": 785.9596557617188,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 67378047,
      "version": 21,
      "versionNonce": 41911807,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785397640201,
      "link": null,
      "locked": false,
      "text": "Dok\u00FCmanlar sekmesinde Kaydet butonu ile herhangi bir mail\ntetiklemesinin yap\u0131lmamas\u0131,",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dok\u00FCmanlar sekmesinde Kaydet butonu ile herhangi bir mail tetiklemesinin yap\u0131lmamas\u0131,",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "c0rpk-N7p9ecAaQIK7_Dx",
      "type": "text",
      "x": 4646.04270717076,
      "y": 1502.4880952380952,
      "width": 713.271728515625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 622671153,
      "version": 47,
      "versionNonce": 604673905,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785397648268,
      "link": null,
      "locked": false,
      "text": "\u0130lgili Firmalar sekmesinde Kaydet butonu haricinde ek\nolarak Payla\u015F butonunun eklenilmesi,",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u0130lgili Firmalar sekmesinde Kaydet butonu haricinde ek olarak Payla\u015F butonunun eklenilmesi,",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uZlZYg6wbJdfn5_1Snqxf",
      "type": "text",
      "x": 4643.8387276785725,
      "y": 1618.4880952380952,
      "width": 757.6796875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 954725503,
      "version": 60,
      "versionNonce": 1318843391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785397657802,
      "link": null,
      "locked": false,
      "text": "\u0130lgili Firmalar sekmesinde Kaydet butonunundan herhangi\nbir mail tetiklemesinin yap\u0131lmamas\u0131,",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u0130lgili Firmalar sekmesinde Kaydet butonunundan herhangi bir mail tetiklemesinin yap\u0131lmamas\u0131,",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
