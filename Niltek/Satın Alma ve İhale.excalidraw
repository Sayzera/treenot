      "seed": 804467139,
      "version": 224,
      "versionNonce": 338706189,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786432463396,
      "link": null,
      "locked": false,
      "text": "- Zeyilname listesi detay\u0131na d\u00FCzenlenecek\nalanlar\u0131n eklenmesi yap\u0131lacakt\u0131r. D\u00FCzenlenecek\nalanlar tiplere g\u00F6re gruplanacakt\u0131r.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
