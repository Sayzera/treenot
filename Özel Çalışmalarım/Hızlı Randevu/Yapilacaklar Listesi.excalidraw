      "isDeleted": false,
      "boundElements": null,
      "updated": 1786351103668,
      "link": null,
      "locked": false,
      "text": "Her kullan\u0131c\u0131 kendi renk paletini se\u00E7ebilmeli \u00F6zelle\u015Ftirebilmeli",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Her kullan\u0131c\u0131 kendi renk paletini se\u00E7ebilmeli \u00F6zelle\u015Ftirebilmeli",
      "autoResize": true,
      "lineHeight": 1.25
    },
