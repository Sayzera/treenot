      "locked": false,
      "text": "Yapay zeka k\u0131sm\u0131n\u0131n sistem taraf\u0131ndan \u00F6nce kapat\u0131lmas\u0131 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Yapay zeka k\u0131sm\u0131n\u0131n sistem taraf\u0131ndan \u00F6nce kapat\u0131lmas\u0131 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Cr9Q3217R3nGI61LTplZN",
      "type": "text",
      "x": 236.33139525768559,
      "y": 134.86803243654634,
      "width": 574.1195678710938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
