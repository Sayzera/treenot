    },
    {
      "id": "eHZaS2rXmugRRyMFBHPOP",
      "type": "text",
      "x": 11291.117512052018,
      "y": 100.1031746031752,
      "width": 773.1717529296875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b48",
