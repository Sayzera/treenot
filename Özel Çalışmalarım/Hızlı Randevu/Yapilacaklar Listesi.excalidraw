      "isDeleted": false,
      "boundElements": [],
      "updated": 1786448061741,
      "link": null,
      "locked": false,
      "text": "Her kullan\u0131c\u0131 kendi renk paletini se\u00E7ebilmeli \u00F6zelle\u015Ftirebilmeli",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
