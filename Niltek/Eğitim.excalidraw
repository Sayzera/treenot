      "seed": 722305306,
      "version": 62,
      "versionNonce": 1672888390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783944079769,
      "link": null,
      "locked": false,
      "text": "3- Talep Etti\u011Fim E\u011Fitimler, Taslak ve Revize durumunda Onaya G\u00F6nder aktif\nolmal\u0131d\u0131r.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3- Talep Etti\u011Fim E\u011Fitimler, Taslak ve Revize durumunda Onaya G\u00F6nder aktif olmal\u0131d\u0131r.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "QFd--k-AKJz2TIt-Id2Is",
      "type": "text",
      "x": 341.040283203125,
      "y": 610.5,
      "width": 694.7395629882812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 2002400646,
      "version": 62,
      "versionNonce": 215107462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783944079769,
      "link": null,
      "locked": false,
      "text": "4- E\u011Fitim Talep Listesi, detay k\u0131sm\u0131nda Kaydet butonu aktif olmamal\u0131d\u0131r.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4- E\u011Fitim Talep Listesi, detay k\u0131sm\u0131nda Kaydet butonu aktif olmamal\u0131d\u0131r.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
